---
import Layout from "../layouts/Layout.astro";
import SearchField from "../components/SearchField.astro";
import Button from "../components/Button.astro";
import Pagination from "../components/Pagination.astro";
import MatchCard from "../components/MatchCard.astro";

type MatchRow = {
  match_id: string;
  match_date: string;
  stadium: string;
  city: string;
  tournament_stage: string;
  team_a: string;
  team_b: string;
  goals_a: number;
  goals_b: number;
};

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

const page = parseInt(Astro.url.searchParams.get("page") || "1", 10);
const limit = parseInt(Astro.url.searchParams.get("limit") || "10", 10);
const search = Astro.url.searchParams.get("search") || "";
const sortBy = Astro.url.searchParams.get("sortBy") || "match_date";
const sortOrder = Astro.url.searchParams.get("sortOrder") || "desc";

let matches: MatchRow[] = [];
let totalPages = 1;
let totalCount = 0;
let backendError = false;

try {
  const apiUrl = `${API_URL}/matches?page=${page}&limit=${limit}&search=${encodeURIComponent(search)}`;

  const response = await fetch(apiUrl);

  if (response.ok) {
    const data = await response.json();
    matches = data.matches ?? [];
    totalCount = data.total ?? 0;
    totalPages = Math.max(1, Math.ceil(totalCount / limit));
  } else {
    backendError = true;
  }
} catch {
  matches = [];
  totalPages = 1;
  totalCount = 0;
  backendError = true;
}

// Match date formatting
matches = matches.map((match) => {
  const matchDate = new Date(match.match_date);
  const formattedDate = matchDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
  return { ...match, match_date: formattedDate };
});
---

<Layout title="Matches" active="matches" container="w-full p-8">
  <!-- HEADING -->
  <div class="flex flex-row items-center gap-4">
    <h1 class="text-2xl font-bold">Matches</h1>
    <SearchField />
    <Button variant="primary" href="/matches/add">+ Add Match</Button>
  </div>

  <p class="mt-2 text-sm text-text-gray">
    {totalCount} matches — showing {matches.length} per page
  </p>

  <!-- Pagination -->
  <Pagination
    page={page}
    totalPages={totalPages}
    limit={limit}
    search={search}
    sortBy={sortBy}
    sortOrder={sortOrder}
  />

  <div class="mt-4 grid gap-4">
    {
      matches.map((match) => (
        <MatchCard
          teamA={match.team_a ?? "TBD"}
          teamB={match.team_b ?? "TBD"}
          score={
            match.goals_a != null
              ? `${match.goals_a} - ${match.goals_b}`
              : undefined
          }
          stadium={match.stadium}
          city={match.city}
          tournamentStage={match.tournament_stage}
          matchTime={match.match_date}
          matchId={match.match_id}
        />
      ))
    }
    {
      matches.length === 0 && (
        <div>
          {backendError ? (
            <div class="mx-auto flex max-w-xl flex-col items-center rounded-2xl border border-primary-20 bg-primary-10/40 px-6 py-10 text-center">
              <div class="mb-5 text-6xl animate-[spin_3s_linear_infinite]">⚽</div>
              <h3 class="mb-2 text-2xl font-semibold text-primary-60">
                Loading match data ...
              </h3>
              <p class="max-w-md text-sm leading-6 text-text-gray">
                The backend may need a moment to wake up. Please wait a few seconds, then refresh the page.
              </p>
            </div>
          ) : (
            <>
              <p class=" text-text-gray">
                No matches found
              </p>
            </>
          )}
        </div>
      )
    }
  </div>
</Layout>
