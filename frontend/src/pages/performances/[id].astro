<script define:vars={{
  performanceId: performance?.id,
  matchId: performance?.match_id,
  API_URL
}}>
  const deleteBtn = document.querySelector("#deletePerformance");
  const saveBtn = document.querySelector("#savePerformance");
  const backButton = document.querySelector("#backButton");

  // Modal Elements
  const saveConfirmModal = document.querySelector("#saveConfirmModal");
  const modalBtnCancel = document.querySelector("#modalBtnCancel");

  // Pack form fields and send the data
  async function submitPerformanceData() {
    const form = document.querySelector("#performance-form");
    if (!form) return false;

    const formData = new FormData(form);
    const body = {};
    
    formData.forEach((value, key) => {
      if (value === "") {
        body[key] = null;
      } else if (!isNaN(Number(value))) {
        body[key] = Number(value);
      } else {
        body[key] = value;
      }
    });

    try {
      const response = await fetch(`${API_URL}/performances/${performanceId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      });
      return response.ok;
    } catch (e) {
      console.error(e);
      return false;
    }
  }

  backButton?.addEventListener("click", () => {
	window.history.back(); // Go back to the previous page (match details)
  });

saveBtn?.addEventListener("click", async () => {
  saveBtn.disabled = true;

  const success = await submitPerformanceData();

  if (success) {
    alert("Performance updated successfully.");
    window.history.back(); // Go back to the previous page (match details)
  } else {
    alert("Failed to save changes.");
    saveBtn.disabled = false;
    saveBtn.innerText = "Save";
  }
});

  // Cancel action
  modalBtnCancel?.addEventListener("click", () => {
    if (saveConfirmModal) {
      saveConfirmModal.classList.remove("flex");
      saveConfirmModal.classList.add("hidden");
    }
  });

  // Delete Action
  deleteBtn?.addEventListener("click", async () => {
    if (!confirm("Are you sure you want to delete this performance?")) return;

    const response = await fetch(`${API_URL}/performances/${performanceId}`, {
      method: "DELETE",
    });

    if (response.ok) {
      alert("Performance deleted successfully.");
      window.history.back(); // Go back to the previous page (match details)
    } else {
      alert("Failed to delete performance.");
    }
  });
</script>