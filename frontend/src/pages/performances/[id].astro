---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import InputNumber from "../../components/InputNumber.astro";
import Avatar from "../../components/Avatar.astro";

type PerformanceRow = {
  id: number;
  player_id: string;
  player_name: string;
  team: string;
  opponent_team: string;
  match_date: string;
  position: string;
  jersey_number: number;
  stadium: string;
  city: string;
  match_result: string;
  goals_team: number;
  goals_opponent: number;
  match_id: string;

  // ⚽ Attacking
  goals: number;
  assists: number;
  shots: number;
  shots_on_target: number;
  expected_goals_xg: number;
  expected_assists_xa: number;
  key_passes: number;
  dribbles_attempted: number;
  successful_dribbles: number;
  crosses: number;
  successful_crosses: number;
  offsides: number;

  // 🎯 Passing
  successful_passes: number;
  total_passes: number;
  pass_accuracy: number;

  // 🛡️ Defensive
  tackles: number;
  interceptions: number;
  clearances: number;
  blocks: number;
  aerial_duels_won: number;
  aerial_duels_lost: number;
  recoveries: number;
  defensive_actions: number;

  // 🚨 Discipline
  fouls_committed: number;
  fouls_suffered: number;
  yellow_cards: number;
  red_cards: number;

  // 🧤 Goalkeeper
  saves: number;
  save_percentage: number;
  punches: number;
  clean_sheet: number;
  goals_conceded: number;
  penalty_saves: number;

  // 🏃 Physical
  minutes_played: number;
  distance_covered_km: number;
  sprint_distance_km: number;
  top_speed_kmh: number;
  accelerations: number;
  decelerations: number;
  stamina_score: number;

  // ⭐ Ratings & Advanced
  player_rating: number;
  performance_score: number;
  offensive_contribution: number;
  defensive_contribution: number;
  possession_impact: number;
  pressure_resistance: number;
  creativity_score: number;
  consistency_score: number;
  clutch_performance_score: number;
};

const API_URL = "http://localhost:3000";
const player_id: string | undefined = Astro.params.id;
let performance: PerformanceRow | null;
try {
  const response = await fetch(`${API_URL}/performances/${player_id}`);
  if (response.ok) {
    performance = await response.json();
  } else {
    performance = null;
  }
} catch {
  performance = null;
}

// Match date formatting
const matchDate = new Date(performance?.match_date || "");
const formattedDate = matchDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const matchRes = await fetch(`${API_URL}/matches/${performance?.match_id}`);
---

<Layout title="Performances" active="performances" container="w-full">
  <div class="space-y-4 p-6">
    <a id="backButton" class="text-sm text-primary cursor-pointer">← Back</a>
    <h1 class="text-2xl font-bold">Update Performance</h1>
    <p class="text-sm text-text-gray">
      Explore player performances in World Cup 2026 matches.
    </p>
  </div>

  <div
    class="mx-6 grid grid-cols-1 md:grid-cols-3 gap-4 p-6 border border-gray-300 rounded-lg bg-gray-50 mb-6"
  >
    <div class="flex flex-row items-center gap-4">
      <Avatar name={performance?.player_name} size="lg" class="mr-2" />
      <div class="flex flex-col items-start gap-1">
        <span class="font-bold text-gray-900">{performance?.player_name}</span>
        <div class="text-sm text-text-gray">
          #{performance?.jersey_number} · {performance?.position}
        </div>
        <span class="text-sm font-semibold">{performance?.team}</span>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center gap-2">
      <div class="flex flex-col items-center gap-1">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-bold"
          >Match</span
        >
        <span class="font-semibold text-gray-800"
          >{performance?.team} vs {performance?.opponent_team}</span
        >
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-bold"
          >Date</span
        >
        <span class="text-sm text-gray-700">{formattedDate}</span>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center gap-2">
      <div class="flex flex-col items-center gap-1">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-bold"
          >Stadium</span
        >
        <span class="text-sm text-gray-700"
          >{performance?.stadium}, {performance?.city}</span
        >
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-xs uppercase tracking-wider text-gray-400 font-bold"
          >Result</span
        >
        <span class="font-semibold text-gray-800">
          {performance?.match_result}
