---
import "../styles/global.css";


export interface Props {
  title: string;
  options: { label: string; value: string }[];
}

const { title, options } = Astro.props;
---

<div class="filter-dropdown relative inline-block text-left">
  <!-- Dropdown Toggle Button -->
  <button
    type="button"
    class="dropdown-btn inline-flex w-full justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
    aria-expanded="false"
  >
    {title}
    <svg class="-mr-1 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class="dropdown-menu absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none hidden"
    role="menu"
  >
    <div class="p-2 border-b border-gray-100">
      <input
        type="text"
        class="dropdown-search w-full rounded-md border-0 py-1.5 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-indigo-600 sm:text-sm"
        placeholder="Search..."
        autocomplete="off"
      />
    </div>
    <div class="py-1 max-h-60 overflow-y-auto" role="none">
      {options.map((option) => (
        <label class="flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer" role="menuitem">
          <input
            type="checkbox"
            name="filter-option"
            value={option.value}
            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
          />
          <span class="ml-3">{option.label}</span>
        </label>
      ))}
    </div>
  </div>
</div>

<script>
  // Scoped to this specific Astro component instance
  document.querySelectorAll('.filter-dropdown').forEach((dropdown) => {
    const btn = dropdown.querySelector('.dropdown-btn') as HTMLButtonElement;
    const menu = dropdown.querySelector('.dropdown-menu') as HTMLDivElement;
    const searchInput = dropdown.querySelector('.dropdown-search') as HTMLInputElement;
    const checkboxes = dropdown.querySelectorAll('input[type="checkbox"]');

    // 1. Toggle dropdown on button click
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });

    // 2. Filter options on search input
    searchInput.addEventListener('input', (e) => {
      const filter = (e.target as HTMLInputElement).value.toLowerCase();
      checkboxes.forEach((cb) => {
        const labelText = cb.parentElement?.textContent?.toLowerCase() || '';
        const labelElement = cb.parentElement as HTMLElement;
        if (labelText.includes(filter)) {
          labelElement.classList.remove('hidden');
        } else {
          labelElement.classList.add('hidden');
        }
      });
    });

    // 3. Custom event for when a filter changes
    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const checkedValues = Array.from(checkboxes)
          .filter((c) => (c as HTMLInputElement).checked)
          .map((c) => (c as HTMLInputElement).value);
        
        // Dispatch custom event to let parent pages/components listen to filter changes
        dropdown.dispatchEvent(new CustomEvent('filter-change', {
          bubbles: true,
          detail: { values: checkedValues }
        }));
      });
    });

    // 4. Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      }
    });
  });
</script>
